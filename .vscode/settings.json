{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "cSpell.words": [
    "ariakit",
    "classname",
    "ecma",
    "firefox",
    "fontawesome",
    "fortawesome",
    "gapi",
    "jiti",
    "montserrat",
    "netlify",
    "pnpx",
    "Pozole",
    "redimensionando",
    "reintentar",
    "roboto",
    "signin",
    "signout",
    "svgr",
    "tailwindcss",
    "tseslint",
    "tsparticles",
    "TTFB",
    "typecheck",
    "webp",
    "xmark"
  ],
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "commandOnAllFiles.commands": {
    "Organize All Imports": {
      "command": "multiCommand.sortImports",
      "includeFileExtensions": [".ts", ".tsx"]
    }
  },
  // See: https://github.com/paolotiu/tailwind-intellisense-regex-list#tailwind-merge
  "tailwindCSS.experimental.classRegex": [
    ["(?:twMerge|twJoin)\\(([^;]*)[\\);]", "[`'\"`]([^'\"`;]*)[`'\"`]"]
  ]
}
