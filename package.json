{
  "name": "vite-project",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@9.0.6",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "run-p test:preview test:vitest",
    "test:preview": "vitest-preview",
    "test:vitest": "vitest --watch=false --config vitest.config.ts",
    "test:coverage": "vitest-preview && vitest run --coverage --watch=false",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "validate": "run-s format lint typecheck && pnpm test",
    "cleanup": "pnpx rimraf pnpm-lock.yaml node_modules dist coverage",
    "tailwind:viewer": "tailwind-config-viewer -o"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.6",
    "@react-oauth/google": "^0.12.1",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "axios": "^1.6.8",
    "i18next": "^23.11.3",
    "jwt-decode": "^4.0.0",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.0.13",
    "react-i18next": "^14.1.1",
    "react-router-dom": "^6.23.0",
    "react": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/gapi.client.drive-v3": "^0.0.5",
    "@types/gapi": "^0.0.47",
    "@types/google.accounts": "^0.0.14",
    "@types/node": "^22.2.0",
    "@types/react-dom": "^18.3.0",
    "@types/react": "^18.3.3",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^2.0.5",
    "autoprefixer": "^10.4.19",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-no-relative-import-paths": "^1.5.4",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-tailwindcss": "^3.15.1",
    "eslint": "^9.8.0",
    "globals": "^15.9.0",
    "happy-dom": "^14.7.1",
    "jiti": "^1.21.6",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "prettier": "^3.2.5",
    "tailwind-config-viewer": "^2.0.2",
    "tailwindcss": "^3.4.3",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.5.3",
    "vite-plugin-svgr": "^4.2.0",
    "vite": "^5.4.0",
    "vitest-preview": "^0.0.1",
    "vitest": "^2.0.5"
  }
}
