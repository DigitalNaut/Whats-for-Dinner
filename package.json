{
  "name": "vite-project",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "run-p test:preview test:vitest",
    "test:preview": "vitest-preview",
    "test:vitest": "vitest --watch=false --config vitest.config.ts",
    "test:coverage": "vitest-preview && vitest run --coverage --watch=false",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "validate": "run-s format lint typecheck && pnpm test",
    "cleanup": "pnpx rimraf pnpm-lock.yaml node_modules dist coverage",
    "tailwind:viewer": "tailwind-config-viewer -o"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.17",
    "@dnd-kit/core": "^6.3.1",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@react-oauth/google": "^0.12.2",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "axios": "^1.10.0",
    "i18next": "^25.3.2",
    "jwt-decode": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-i18next": "^15.6.0",
    "react-router-dom": "^7.7.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/gapi": "^0.0.47",
    "@types/gapi.client.drive-v3": "^0.0.5",
    "@types/google.accounts": "^0.0.17",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "globals": "^16.3.0",
    "happy-dom": "^18.0.1",
    "jiti": "^2.4.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwind-config-viewer": "^2.0.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.5",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.2.4",
    "vitest-preview": "^0.0.1"
  }
}
